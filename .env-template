ARIZE_SPACE_ID=<adjust to your space. Get from Arize UI>
ARIZE_API_KEY=<Get from Settings in the Arize UI>
ARIZE_PROJECT_NAME=<Adjust to something like arize-quickstart>

# Set to https://otlp.arize.com/v1/traces if in US
# Set to https://otlp.eu-west-1a.arize.com/v1/traces for EU
# Set to https://otlp.<region>.arize.com for other regions
ARIZE_OTLP_ENDPOINT=https://otlp.eu-west-1a.arize.com/v1/traces

# Set to your environment
AZURE_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic
AZURE_DEPLOYMENT_NAME=claude-haiku-4-5
AZURE_API_KEY=<your azure key>
